datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id           String    @id @default(uuid())
  usuario      String    @unique
  hashSenha    String
  salt         String
  papel        String    // ADMINISTRADOR, OPERADOR_CADASTRO, GESTOR_ALMOXARIFADO, AUDITOR
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime  @default(now())
  criadoEm     DateTime  @default(now())

  @@map("usuarios")
}

model Organizacao {
  id                String           @id @default(uuid())
  razaoSocial       String
  cnpj              String           @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  ativo             Boolean          @default(true)
  versao            Int              @default(1)
  dataCadastro      DateTime         @default(now())

  contrato          Contrato?
  lotes             Lote[]
  apiKeys           ApiKeyParceiro[]

  @@map("organizacoes")
}

model Contrato {
  id                  String      @id @default(uuid())
  organizacaoId       String      @unique
  dataAssinatura      DateTime    @default(now())
  dataVencimento      DateTime
  clausulasJson       String      @default("[]")
  valorMensal         Float
  renovacaoAutomatica Boolean     @default(false)
  versao              Int         @default(1)
  criadoEm            DateTime    @default(now())

  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

model Lote {
  id                  String        @id @default(uuid())
  dataEntrada         DateTime      @default(now())
  dataConclusaoTriagem DateTime?
  operadorTriagem     String?
  organizacaoId       String
  notaFiscal          String
  transportadora      String
  statusProcessamento String        @default("RECEBIDO") // RECEBIDO, EM_TRIAGEM, TRIAGEM_CONCLUIDA, ENCAMINHADO, FINALIZADO
  observacoes         String?
  versao              Int           @default(1)
  criadoEm            DateTime      @default(now())

  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id])
  equipamentos        Equipamento[]

  @@map("lotes")
}

model Equipamento {
  id                  String         @id @default(uuid())
  codigoBarrasInterno String         @unique
  tipo                String         // COMPUTADOR_MESA, NOTEBOOK, MONITOR, IMPRESSORA, SERVIDOR, ROTEADOR, CABO_ESTRUTURADO, FONTE_ALIMENTACAO
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        String         // NOVO, BOM_ESTADO, USADO_LEVE, USADO_MODERADO, DANIFICADO_LEVE, DANIFICADO_GRAVE, INSERVIVEL
  pesoQuilogramas     Float
  valorEstimadoRecuperacao Float?
  loteId              String
  posicaoNoLote       Int            @default(1)
  statusRastreamento  String         @default("AGUARDANDO_TRIAGEM") // AGUARDANDO_TRIAGEM, EM_TRIAGEM, AGUARDANDO_DESMONTE, EM_DESMONTE, PECAS_REAPROVEITADAS, MATERIAL_RECICLAVEL, DESCARTE_SEGURO, BAIXA_DEFINITIVA
  justificativaEstado String?
  versao              Int            @default(1)
  criadoEm            DateTime       @default(now())

  lote                Lote           @relation(fields: [loteId], references: [id], onDelete: Cascade)
  movimentacoes       Movimentacao[]

  @@map("equipamentos")
}

model Movimentacao {
  id            String      @id @default(uuid())
  equipamentoId String
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String?

  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@map("movimentacoes")
}

model JournalTransacao {
  id                 String   @id @default(uuid())
  timestamp          DateTime @default(now())
  operacao           String
  entidade           String
  dadosAntes         String?  // JSON string
  dadosDepois        String?  // JSON string
  usuarioResponsavel String

  @@map("journal_transacoes")
}

model ParametroGlobal {
  id                          String @id @default("CONFIG_GLOBAL")
  aliquotaImpostoPadrao       Float  @default(0.12)
  coeficienteDepreciacaoAnual Float  @default(0.20)

  @@map("parametros_globais")
}

// ============================================================================
// NOVOS MODELOS DA ATIVIDADE 3 (AV3) - INTELIGÊNCIA ANALÍTICA, API PÚBLICA E FILAS
// ============================================================================

model ApiKeyParceiro {
  id                    String       @id @default(uuid())
  nomeParceiro          String
  organizacaoId         String?
  prefixoChave          String       // ex: "gc_live_9f8a"
  hashChave             String       @unique // SHA-256 hash da chave para segurança em repouso
  permissoesJson        String       @default("[\"READ_RASTREABILIDADE\"]") // ["READ_RASTREABILIDADE", "WRITE_LOTES", "READ_ANALYTICS"]
  limiteRequisicoesMin  Int          @default(60) // Rate limit customizável por parceiro
  planoAcesso           String       @default("STANDARD") // BASIC, STANDARD, ENTERPRISE
  ativa                 Boolean      @default(true)
  totalRequisicoes      Int          @default(0)
  ultimoUsoEm           DateTime?
  expiraEm              DateTime?
  criadoEm              DateTime     @default(now())

  organizacao           Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: SetNull)

  @@map("api_keys_parceiros")
}

model RelatorioEficiencia {
  id                        String   @id @default(uuid())
  periodoReferencia         String   // ex: "2025-Q1" ou "GLOBAL"
  totalLotesAnalisados      Int
  tempoMedioTriagemHoras    Float
  tempoMedianoTriagemHoras  Float
  desvioPadraoTriagemHoras  Float
  operadorMaisEficiente     String?
  gargaloIdentificado       String
  metricasPorOperadorJson   String   // JSON detalhando operadores e períodos do ano
  metricasPorPeriodoJson    String   // JSON com sazonalidade/períodos
  geradoPor                 String   @default("SISTEMA_ANALITICO")
  criadoEm                  DateTime @default(now())

  @@map("relatorios_eficiencia")
}

model RelatorioRentabilidade {
  id                            String   @id @default(uuid())
  tipoEquipamento               String
  marcaAnalisada                String   @default("TODAS")
  totalUnidadesAmostra          Int
  pesoMedioKg                   Float
  valorMedioRecuperacaoBRL      Float
  valorMedianoRecuperacaoBRL    Float
  desvioPadraoRecuperacaoBRL    Float
  valorTotalPotencialBRL        Float
  indicePriorizacao             Float    // Score calculado para priorização pelo cliente
  detalhamentoPorEstadoMarcaJson String  // JSON com breakdown por estado físico, marca e modelo
  geradoPor                     String   @default("SISTEMA_ANALITICO")
  criadoEm                      DateTime @default(now())

  @@map("relatorios_rentabilidade")
}

model RelatorioPreditivo {
  id                              String   @id @default(uuid())
  tipoEquipamento                 String
  modeloAnalisado                 String   @default("OLS_E_SUAVIZACAO_EXPONENCIAL")
  totalAmostrasHistoricas         Int
  coeficienteAngularOLS           Float    // Slope (b1) da regressão linear por Mínimos Quadrados Ordinários
  interceptoOLS                   Float    // Intercept (b0) da regressão linear
  coeficienteDeterminacaoR2       Float    // R² da regressão OLS
  idadeMediaAtualAnos             Float
  vidaUtilTotalEstimadaAnos       Float    // Idade projetada em que o equipamento atinge o estado INSERVIVEL (depreciação >= 98%)
  vidaUtilRemanescenteMediaAnos   Float
  anoProjetadoInservivel          Int
  suavizacaoExponencialAlfa       Float    @default(0.35)
  taxaFalhaSuavizada              Float
  projecoesDetalhadasJson         String   // JSON com série histórica, linha de tendência OLS e previsões por equipamento
  geradoPor                       String   @default("SISTEMA_ANALITICO")
  criadoEm                        DateTime @default(now())

  @@map("relatorios_preditivos")
}

model TarefaRelatorio {
  id                  String    @id @default(uuid())
  tipoRelatorio       String    // PREDITIVO_COMPLETO, EFICIENCIA_OPERACIONAL, RENTABILIDADE_EQUIPAMENTOS, CONSOLIDADO_PARCEIRO
  formatoSaida        String    @default("JSON") // JSON, CSV
  status              String    @default("AGUARDANDO") // AGUARDANDO, PROCESSANDO, CONCLUIDO, FALHA
  solicitante         String    // ID do usuário ou nome do parceiro da API Key
  organizacaoFiltroId String?
  parametrosJson      String    @default("{}")
  tentativas          Int       @default(0)
  maxTentativas       Int       @default(3)
  progressoPercentual Int       @default(0)
  caminhoArquivo      String?
  conteudoResultado   String?   // Payload gerado (JSON ou CSV) para download imediato
  erroMensagem        String?
  webhookUrl          String?
  iniciadoEm          DateTime?
  concluidoEm         DateTime?
  criadoEm            DateTime  @default(now())

  @@map("tarefas_relatorios")
}
