@startuml av3_diagrama_er
title GreenCode - Modelo Entidade-Relacionamento Relacional Expandido (Prisma ORM / AV3)
skinparam linetype ortho
skinparam packageStyle rectangle

entity "Organizacao" as organizacao {
  * id : VARCHAR(36) [PK]
  --
  * razaoSocial : VARCHAR(150)
  * cnpj : VARCHAR(18) [UNIQUE]
  * inscricaoEstadual : VARCHAR(30)
  * enderecoCompleto : TEXT
  * telefone : VARCHAR(20)
  * email : VARCHAR(100)
  * ativo : BOOLEAN
  * versao : INT
}

entity "Contrato" as contrato {
  * id : VARCHAR(36) [PK]
  --
  * organizacaoId : VARCHAR(36) [FK, UNIQUE]
  * dataAssinatura : TIMESTAMP
  * dataVencimento : TIMESTAMP
  * valorMensal : DECIMAL(10,2)
  * versao : INT
}

entity "Lote" as lote {
  * id : VARCHAR(36) [PK]
  --
  * organizacaoId : VARCHAR(36) [FK]
  * dataEntrada : TIMESTAMP
  dataConclusaoTriagem : TIMESTAMP
  operadorTriagem : VARCHAR(80)
  * notaFiscal : VARCHAR(50)
  * transportadora : VARCHAR(100)
  * statusProcessamento : VARCHAR(30)
  * versao : INT
}

entity "Equipamento" as equipamento {
  * id : VARCHAR(36) [PK]
  --
  * loteId : VARCHAR(36) [FK]
  * codigoBarrasInterno : VARCHAR(60) [UNIQUE]
  * tipo : VARCHAR(40)
  * marca : VARCHAR(50)
  * modelo : VARCHAR(80)
  * anoFabricacao : INT
  * estadoFisico : VARCHAR(30)
  * pesoQuilogramas : DECIMAL(8,3)
  valorEstimadoRecuperacao : DECIMAL(10,2)
  * statusRastreamento : VARCHAR(40)
  * versao : INT
}

entity "Movimentacao" as movimentacao {
  * id : VARCHAR(36) [PK]
  --
  * equipamentoId : VARCHAR(36) [FK]
  * dataHora : TIMESTAMP
  * origem : VARCHAR(100)
  * destino : VARCHAR(100)
  * responsavel : VARCHAR(100)
}

entity "ApiKeyParceiro (AV3)" as apikey {
  * id : VARCHAR(36) [PK]
  --
  * nomeParceiro : VARCHAR(120)
  organizacaoId : VARCHAR(36) [FK]
  * prefixoChave : VARCHAR(20)
  * hashChave : VARCHAR(64) [UNIQUE]
  * permissoesJson : TEXT
  * limiteRequisicoesMin : INT
  * planoAcesso : VARCHAR(30)
  * ativa : BOOLEAN
  * totalRequisicoes : INT
  ultimoUsoEm : TIMESTAMP
  expiraEm : TIMESTAMP
}

entity "RelatorioEficiencia (AV3)" as relef {
  * id : VARCHAR(36) [PK]
  --
  * periodoReferencia : VARCHAR(40)
  * totalLotesAnalisados : INT
  * tempoMedioTriagemHoras : FLOAT
  * tempoMedianoTriagemHoras : FLOAT
  * desvioPadraoTriagemHoras : FLOAT
  operadorMaisEficiente : VARCHAR(80)
  * gargaloIdentificado : TEXT
  * metricasPorOperadorJson : TEXT
  * metricasPorPeriodoJson : TEXT
  * criadoEm : TIMESTAMP
}

entity "RelatorioRentabilidade (AV3)" as relrent {
  * id : VARCHAR(36) [PK]
  --
  * tipoEquipamento : VARCHAR(40)
  * marcaAnalisada : VARCHAR(50)
  * totalUnidadesAmostra : INT
  * pesoMedioKg : FLOAT
  * valorMedioRecuperacaoBRL : FLOAT
  * valorMedianoRecuperacaoBRL : FLOAT
  * desvioPadraoRecuperacaoBRL : FLOAT
  * valorTotalPotencialBRL : FLOAT
  * indicePriorizacao : FLOAT
  * detalhamentoPorEstadoMarcaJson : TEXT
  * criadoEm : TIMESTAMP
}

entity "RelatorioPreditivo (AV3)" as relpred {
  * id : VARCHAR(36) [PK]
  --
  * tipoEquipamento : VARCHAR(40)
  * modeloAnalisado : VARCHAR(50)
  * totalAmostrasHistoricas : INT
  * coeficienteAngularOLS : FLOAT
  * interceptoOLS : FLOAT
  * coeficienteDeterminacaoR2 : FLOAT
  * idadeMediaAtualAnos : FLOAT
  * vidaUtilTotalEstimadaAnos : FLOAT
  * vidaUtilRemanescenteMediaAnos : FLOAT
  * anoProjetadoInservivel : INT
  * suavizacaoExponencialAlfa : FLOAT
  * taxaFalhaSuavizada : FLOAT
  * projecoesDetalhadasJson : TEXT
  * criadoEm : TIMESTAMP
}

entity "TarefaRelatorio (AV3)" as tarefa {
  * id : VARCHAR(36) [PK]
  --
  * tipoRelatorio : VARCHAR(50)
  * formatoSaida : VARCHAR(10)
  * status : VARCHAR(20)
  * solicitante : VARCHAR(120)
  organizacaoFiltroId : VARCHAR(36)
  * tentativas : INT
  * maxTentativas : INT
  * progressoPercentual : INT
  caminhoArquivo : TEXT
  conteudoResultado : TEXT
  erroMensagem : TEXT
  iniciadoEm : TIMESTAMP
  concluidoEm : TIMESTAMP
  * criadoEm : TIMESTAMP
}

organizacao ||--o| contrato : "1 possui 0..1"
organizacao ||--o{ lote : "1 gera N"
organizacao ||--o{ apikey : "1 vincula 0..N"
lote ||--o{ equipamento : "1 contem N"
equipamento ||--o{ movimentacao : "1 registra N"
@enduml
